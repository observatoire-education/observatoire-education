---
// Tableau des collectivités d'un niveau (collèges ou lycées), triées par nom : dernier exercice publié, en € par élève.
import { comparerCollectivites, type NiveauBudget } from "@obs/shared/collectivites";
import type { BudgetCollectivite } from "@obs/shared/donnees";
import { LIBELLES_BUDGET as L } from "@obs/shared/libelles";
import { brutBudget, montantBudget } from "../lib/budget";
import { departementsDisponibles, regionsDisponibles } from "../lib/donnees";
import Cellule from "./Cellule.astro";

interface Props { collectivites: BudgetCollectivite[]; niveau: NiveauBudget }
const { collectivites, niveau } = Astro.props;
const lignes = [...collectivites].sort(comparerCollectivites);
const exercice = Math.max(...lignes.map((c) => c.exercices.at(-1)?.exercice ?? 0));
// Les départements (et la Ville de Paris, qui en exerce la compétence) et les régions renvoient à leur page.
const pagesDep = new Set(departementsDisponibles());
const pagesReg = new Set(regionsDisponibles());
const lienCollectivite = (id: string): string | null => {
  const dep = id === "paris" ? "75" : id.startsWith("dep-") ? id.slice(4) : null;
  if (dep) return pagesDep.has(dep) ? `/departement/${dep}/` : null;
  const reg = id.startsWith("reg-") ? id.slice(4) : null;
  return reg && pagesReg.has(reg) ? `/region/${reg}/` : null;
};
const contribution = niveau === "colleges" ? L.postes.contributionColleges : L.postes.contributionLycees;
---
<div class="moyens moyens-tableau">
  <div class="card" style="padding:4px 6px"><div class="table-wrap">
    <table class="cmp mini-t budget">
      <caption class="mute">{L.unites.parEleve} ({contribution} : {L.unites.parElevePrive}) · {L.interface.exercice(exercice)}</caption>
      <thead><tr>
        <th>{L.interface.collectivite}</th>
        <th class="n">{L.postes.horsPersonnel}</th><th class="n">{L.postes.avecPersonnel}</th>
        <th class="n">{L.postes.investissement}</th><th class="n">{contribution}</th><th class="n">{L.interface.investissementPrive}</th>
      </tr></thead>
      <tbody>
        {lignes.map((c) => {
          const e = c.exercices.at(-1);
          const cellules = e
            ? [[e.public.horsPersonnel, "pub"], [e.public.avecPersonnel, "pub"], [e.public.investissement, "pub"], [e.prive.fonctionnement, "pri"], [e.prive.investissement, "pri"]] as const
            : [];
          const lien = lienCollectivite(c.id);
          return (
            <tr>
              <th scope="row">{lien ? <a href={lien}>{c.libelle}</a> : c.libelle}</th>
              {cellules.map(([m, s]) => {
                const a = montantBudget(m, niveau);
                return <td class={`n ${s}`}><Cellule texte={a.texte} absent={a.absent} /></td>;
              })}
            </tr>
          );
        })}
      </tbody>
    </table>
  </div></div>
  <div class="src">{L.source(exercice)} · {L.moyenne.calculee}{brutBudget(`budget_${exercice}`) && <> · <a href={brutBudget(`budget_${exercice}`)}>{L.interface.donneeBrute}</a></>}</div>
</div>
