---
// Sources de la page : producteur, titre, millésime, date de collecte, lien vers la donnée brute archivée.
import { date } from "@obs/shared/format";
import type { Fiche } from "@obs/shared/types";
import { anneeScolaire } from "../lib/affichage";
import { lienPermanent } from "../lib/config";

interface Props { f: Fiche; genereLe: string }
const { f, genereLe } = Astro.props;
const lien = lienPermanent(`/etablissement/${f.uai}/`);
---
<section id="sources">
  <h2>Sources de cette page</h2>
  <div class="card" style="font-size:13px">
    <ul style="margin:0;padding-left:18px;line-height:1.9">
      {f.sources.map((s) => (
        <li>
          {s.producteur}, <a href={s.pageUrl}>{s.titre}</a>
          {s.rentree !== null && <> · rentrée {anneeScolaire(s.rentree)}</>}
          {" · "}collecté le {date(s.collecteLe)} · <a href={s.brutUrl}>donnée brute</a>
        </li>
      ))}
    </ul>
    <div class="src">Licence Ouverte 2.0 (Etalab). Page générée le {date(genereLe)}. Lien permanent : <span class="num">{lien}</span></div>
  </div>
</section>
