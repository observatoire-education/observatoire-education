---
// Corps de la fiche d'une école (maternelle, élémentaire, primaire), sous l'en-tête commun, en onglets : synthèse
// (chiffres, moyens de la commune, courbe), élèves et classes, composition sociale, enseignants, moyens de la commune
// (école publique seulement), alentours (rattachements, écoles proches), sources. Une seule courbe pour tenir le poids ;
// le bloc des moyens n'a pas de graphique d'évolution (il est sur la page de la commune).
import { entier } from "@obs/shared/format";
import { type CodeIndicateur, LIBELLES, LIBELLES_BUDGET, LIBELLES_ECOLES as LE, LIBELLES_ONGLETS as LO, libelleTypeClasse, NIVEAUX_TERRITORIAUX } from "@obs/shared/libelles";
import type { Fiche, Niveau, Secteur, SourceId } from "@obs/shared/types";
import Absence from "./Absence.astro";
import BlocBudget from "./BlocBudget.astro";
import BlocEcolesProches from "./BlocEcolesProches.astro";
import BlocRattachements from "./BlocRattachements.astro";
import Cellule from "./Cellule.astro";
import Empile from "./Empile.astro";
import FicheA4 from "./FicheA4.astro";
import LigneSource from "./LigneSource.astro";
import Onglets from "./Onglets.astro";
import Panneau from "./Panneau.astro";
import Sources from "./Sources.astro";
import SyntheseEcole from "./SyntheseEcole.astro";
import { absente, anneeScolaire, comparaison, indicateur, reference, refAbsente, repartition, source, valeur } from "../lib/affichage";
import { avecOnglets as plusieursOnglets, onglets } from "../lib/onglets";

interface Props { f: Fiche }
const { f } = Astro.props;
const nd = LIBELLES.nonDisponible;
const NIVEAUX: Niveau[] = ["departement", "academie", "france"];
const libelleNiveau = (n: Niveau) => (n === "departement" ? f.depLibelle : NIVEAUX_TERRITORIAUX[n]);
/** L'indicateur s'il figure dans la fiche (les écoles n'ont ni vie scolaire, ni agrégés, ni écart-type de l'IPS). */
const present = (code: CodeIndicateur) => f.indicateurs.some((i) => i.code === code);

// Élèves et classes
const iEleves = indicateur(f, "eleves");
const cl = f.classes ?? null;
const el = f.eleves;
const rentree = iEleves.mesure.rentree ?? cl?.rentree ?? null;
const niveaux = (el?.niveaux ?? []).filter((n) => n.eleves !== 0);
const lignesSpeciales = [
  ...(f.ulis || (el?.ulis ?? 0) > 0 ? [{ libelle: LE.ulis, eleves: el?.ulis ?? null }] : []),
  ...((el?.ueea ?? 0) > 0 ? [{ libelle: LE.ueea, eleves: el?.ueea ?? null }] : []),
];
const idsEffectifs = [...new Set<SourceId>([...(el?.source ?? []), ...(cl?.source ?? [])])].filter((id) => id !== "classes_ecoles");
const types = cl?.types ?? null;
const unNiveau = (types ?? []).filter((t) => t.niveaux === 1);
const plusieursNiveaux = (types ?? []).filter((t) => t.niveaux > 1);
const somme = (ts: typeof unNiveau) => ts.reduce((a, t) => a + t.classes, 0);

// Composition sociale : l'IPS de l'école, à sa propre rentrée.
const iIps = indicateur(f, "ips");
const ipsPublie = iIps.mesure.statut === "ok" && iIps.mesure.valeur !== null;
const refsIps = NIVEAUX.some((n) => !refAbsente(reference(iIps, n, "public")) || !refAbsente(reference(iIps, n, "prive_sous_contrat")));
const ipsCalculee = iIps.comparaisons.some((c) => c.calculee);
const sourceIps = iIps.mesure.source ? source(f, iIps.mesure.source) : f.sources.find((s) => s.id.startsWith("ips_"));

// Enseignants. Pour tenir le poids de la page, chaque chiffre une seule fois : élèves par ETP et part de femmes
// dans le tableau (département et France) ; âge et ancienneté en barres empilées (département), sans les reprendre
// en lignes. La fiche imprimable donne toutes les parts avec l'académie et la France.
const RATIOS = ([
  ["eleves_par_etp_ens", "Élèves par ETP enseignant"],
  ["part_enseignantes", "Enseignantes"],
] as [CodeIndicateur, string][]).filter(([code]) => present(code));
const COLONNES: [Niveau, Secteur, string][] = [
  ["departement", "public", "Dép. public"], ["departement", "prive_sous_contrat", "Dép. privé"],
  ["france", "public", "France public"], ["france", "prive_sous_contrat", "France privé"],
];
const etpEns = present("etp_enseignants") ? indicateur(f, "etp_enseignants").mesure : null;
const sourcePersonnels = source(f, "personnels_ecoles");
// La répartition femmes et hommes n'a que deux catégories : la ligne « Enseignantes » la dit déjà.
const REPARTITIONS = [["ages", "Âge"], ["anciennete", "Ancienneté dans l'école"]] as const;

// Onglets : chaque bloc garde les `id` de ses sections. Alentours : rattachements et écoles proches, s'il y en a.
const alentours = f.rattachements || f.ecolesProches !== undefined;
const barre = onglets([
  { id: "o-synthese", libelle: LO.synthese },
  { id: "o-eleves", libelle: LO.elevesClasses },
  { id: "o-social", libelle: LO.social },
  { id: "o-enseignants", libelle: LO.enseignants },
  ...(f.budget.ecoles !== undefined ? [{ id: "o-moyens", libelle: LO.moyensCommune }] : []),
  ...(alentours ? [{ id: "o-alentours", libelle: LO.alentours }] : []),
  { id: "o-sources", libelle: LO.sources },
]);
const avec = plusieursOnglets(barre);
---
<Onglets onglets={barre} />
<Panneau id="o-synthese" libelle={LO.synthese} actif avecOnglets={avec}><SyntheseEcole f={f} /></Panneau>

<Panneau id="o-eleves" libelle={LO.elevesClasses} avecOnglets={avec}>
<section id="eleves">
  <h2>Élèves</h2>
  <div class="card">
      <div class="lab"><span>Par niveau</span><span class="yr">{el ? anneeScolaire(el.rentree) : ""}</span></div>
      {niveaux.length === 0 && lignesSpeciales.length === 0 ? <Absence texte="détail par niveau non disponible" /> : (
        <table class="mini-t">
          <thead><tr><th>Niveau</th><th class="n">Élèves</th></tr></thead>
          <tbody>
            {[...niveaux, ...lignesSpeciales].map((n) => (
              <tr><td>{n.libelle}</td><td class="n"><Cellule texte={n.eleves === null ? nd : entier(n.eleves)} absent={n.eleves === null} /></td></tr>
            ))}
          </tbody>
        </table>
      )}
    </div>
  {idsEffectifs.map((id) => <LigneSource s={source(f, id)} complement={id === "effectifs_ecoles" ? "moyennes calculées (Σ / Σ)" : undefined} />)}
</section>

<section id="classes">
  <h2>{LE.classes}</h2>
  <div class="card">
    <div class="lab"><span>Type des classes</span><span class="yr">{cl ? anneeScolaire(cl.rentree) : ""}</span></div>
    {types === null || types.length === 0 ? <Absence texte="typologie des classes non disponible" /> : (
      <table class="mini-t">
        <tbody>
          {([[LE.unNiveau, unNiveau], [LE.plusieursNiveaux, plusieursNiveaux]] as const).filter(([, ts]) => ts.length > 0).map(([titre, ts]) => (
            <>
              <tr><th>{titre}</th><th class="n">{entier(somme(ts))}</th></tr>
              {ts.map((t) => <tr><td>{libelleTypeClasse(t.libelle)}</td><td class="n">{entier(t.classes)}</td></tr>)}
            </>
          ))}
        </tbody>
      </table>
    )}
    <LigneSource s={source(f, "classes_ecoles")} />
  </div>
</section>
</Panneau>

<Panneau id="o-social" libelle={LO.social} avecOnglets={avec}>
<section id="social">
  <h2>Composition sociale</h2>
  <div class="card">
    <div class="lab"><span>Indice de position sociale</span><span class="yr">{anneeScolaire(iIps.mesure.rentree)}</span></div>
    {ipsPublie
      ? <div class="num ecole-v">{valeur("ips", iIps.mesure)}</div>
      : <div class="ecole-v"><Absence texte={LE.ipsNonPublie} /></div>}
    {refsIps && (
      <table class="cmp mini-t">
        <thead><tr><th>Écart (moyenne)</th><th class="n">public</th><th class="n">privé s. c.</th></tr></thead>
        <tbody>
          {NIVEAUX.map((n) => (
            <tr>
              <td>{libelleNiveau(n)}</td>
              {(["public", "prive_sous_contrat"] as const).map((s) => (
                <td class={`n ${s === "public" ? "pub" : "pri"}`}><Cellule texte={comparaison("ips", reference(iIps, n, s), iIps.mesure)} absent={refAbsente(reference(iIps, n, s))} /></td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    )}
    {iIps.historique.length > 1 && (
      <p class="ecole-note">Évolution : {iIps.historique.map(([a, v]) => `${a} ${valeur("ips", { valeur: v, statut: "ok", source: null, rentree: a })}`).join(", ")}</p>
    )}
    {ipsPublie && <LigneSource s={sourceIps} complement={ipsCalculee ? LIBELLES_BUDGET.moyenne.calculee : "moyennes publiées par la DEPP"} />}
  </div>
</section>
</Panneau>

<Panneau id="o-enseignants" libelle={LO.enseignants} avecOnglets={avec}>
<section id="ens">
  <h2>Enseignants</h2>
  <div class="cols2">
    {etpEns && (
      <div class="card">
        <div class="lab"><span>ETP enseignants</span><span class="yr">{anneeScolaire(etpEns.rentree)}</span></div>
        {absente(etpEns) ? <Absence texte={valeur("etp_enseignants", etpEns)} /> : <div class="num ecole-v">{valeur("etp_enseignants", etpEns)}</div>}
        <div class="ecole-note">Un volume d'ETP n'a pas de moyenne : seuls les ratios et les parts en ont une.</div>
      </div>
    )}
    {RATIOS.length > 0 && (
      <div class="card wide">
        <div class="lab"><span>Ratios et parts, écart à la moyenne (moyenne entre parenthèses)</span><span class="yr">{anneeScolaire(etpEns?.rentree ?? null)}</span></div>
        <div class="table-wrap"><table class="mini-t cmp">
          <thead><tr><th></th><th class="n">École</th>{COLONNES.map(([, , l]) => <th class="n">{l}</th>)}</tr></thead>
          <tbody>
            {RATIOS.map(([code, libelle]) => {
              const i = indicateur(f, code);
              return (
                <tr>
                  <td>{libelle}</td>
                  <td class="n"><Cellule texte={valeur(code, i.mesure)} absent={absente(i.mesure)} gras /></td>
                  {COLONNES.map(([n, s]) => (
                    <td class={`n ${s === "public" ? "pub" : "pri"}`}><Cellule texte={comparaison(code, reference(i, n, s), i.mesure)} absent={refAbsente(reference(i, n, s))} /></td>
                  ))}
                </tr>
              );
            })}
          </tbody>
        </table></div>
      </div>
    )}
    {REPARTITIONS.map(([code, titre]) => {
      const r = repartition(f, code);
      return r && <div class="card"><div class="lab"><span>{titre}</span><span class="yr">part des ETP</span></div><Empile r={r} libelle="Cette école" /></div>;
    })}
  </div>
  <LigneSource s={sourcePersonnels} complement="parts calculées sur les ETP ; moyennes Σ / Σ" />
</section>
</Panneau>

{f.budget.ecoles !== undefined && (
<Panneau id="o-moyens" libelle={LO.moyensCommune} avecOnglets={avec}>
    <section id="moyens">
      <h2>{LIBELLES_BUDGET.titreCommune}</h2>
      <BlocBudget budget={f.budget.ecoles} france={f.budget.france.find((m) => m.niveau === "ecoles")} secteurEnPremier="public"
        evolution={false} niveau="ecoles" motif={f.budget.motif} />
    </section>
</Panneau>
)}

{alentours && (
<Panneau id="o-alentours" libelle={LO.alentours} avecOnglets={avec}>
{f.rattachements && <BlocRattachements r={f.rattachements} uai={f.uai} prive={f.secteur === "prive_sous_contrat"} />}
{f.ecolesProches !== undefined && <BlocEcolesProches f={f} p={f.ecolesProches} />}
</Panneau>
)}

<Panneau id="o-sources" libelle={LO.sources} avecOnglets={avec}><Sources f={f} /></Panneau>
<FicheA4 f={f} />
