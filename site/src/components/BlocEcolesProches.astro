---
// Autour de l'école (spec, section 6.6) : écoles ouvertes compatibles les plus proches, à vol d'oiseau, triées par
// distance ; maternelle ou primaire et élémentaire ou primaire les plus proches (ou leur absence à moins de 50 km) ;
// phrase « Aucune autre école à moins de n km » quand elle s'applique. Sans coordonnées, l'absence est dite. Élèves et classes de la dernière rentrée
// publiée pour les écoles (rentrée dans le titre de la colonne, source citée dans la section « Sources »).
// Page commune sans école (`commune`) : depuis le centre de la commune, toutes les écoles, « Aucune école à moins de n km ».
import { entier, nombre } from "@obs/shared/format";
import {
  FAMILLES, LIBELLES_COMMUNE_ECOLES as LC, LIBELLES_ECOLES_PROCHES as LP, LIBELLES_RATTACHEMENTS as LR, SECTEURS,
} from "@obs/shared/libelles";
import type { EcoleProche, EcolesProches, Fiche } from "@obs/shared/types";
import { anneeScolaire } from "../lib/affichage";
import Absence from "./Absence.astro";
import Cellule from "./Cellule.astro";

/** `f` : fiche de l'école ; page commune : `rentree` des élèves et des classes, et `commune`. */
type Props = { f: Fiche; p: EcolesProches | null; commune?: false } | { p: EcolesProches; rentree: number | null; commune: true };
const props = Astro.props;
const { p } = props;
const commune = props.commune === true;
const rentree = props.commune ? props.rentree : props.f.sources.find((s) => s.id === "effectifs_ecoles")?.rentree;
const titre = (libelle: string) => (rentree ? `${libelle} ${anneeScolaire(rentree)}` : libelle);
const km = (e: EcoleProche) => `${nombre(e.distanceKm)} km`;
// [libellé, école la plus proche, absence dite quand il n'y en a aucune dans le rayon]
const plusProches: [string, EcoleProche | null, string][] = p
  ? [[LP.plusProcheMaternelle, p.plusProcheMaternelle, LP.aucuneMaternelle], [LP.plusProcheElementaire, p.plusProcheElementaire, LP.aucuneElementaire]]
  : [];
---
<section id={commune ? "ecoles-proches" : "autour"}>
  <h2>{commune ? LC.titreProches : LP.titre}</h2>
  <div class="card">
    {p === null ? <Absence texte={LP.sansCoordonnees} /> : (
      <>
        {p.aucuneAMoinsDe !== null && <p>{(commune ? LC.aucuneAMoinsDe : LP.aucuneAMoinsDe)(p.aucuneAMoinsDe)}</p>}
        {plusProches.map(([libelle, e, aucune]) => (
          e ? <p>{libelle} <a href={`/etablissement/${e.uai}/`}>{e.nom}</a>, {km(e)}</p> : <p><Absence texte={aucune} /></p>
        ))}
        {p.liste.length > 0 && (
          <div class="table-wrap">
            <table class="mini-t">
              <thead><tr><th>École</th><th class="n">Distance</th><th>Nature</th><th>Secteur</th><th class="n">{titre("Élèves")}</th><th class="n">{titre("Classes")}</th></tr></thead>
              <tbody>
                {p.liste.map((e) => (
                  <tr>
                    <td><a href={`/etablissement/${e.uai}/`}>{e.nom}</a></td>
                    <td class="n">{km(e)}</td>
                    <td>{FAMILLES[e.famille]}</td>
                    <td><span class={`sect ${e.secteur === "public" ? "pub" : "pri"}`}>{e.secteur === "public" ? SECTEURS.public : "Privé s. c."}</span></td>
                    <td class="n"><Cellule texte={e.eleves === null ? LR.nonPublie : entier(e.eleves)} absent={e.eleves === null} /></td>
                    <td class="n"><Cellule texte={e.classes === null ? LR.nonPublie : entier(e.classes)} absent={e.classes === null} /></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        <p class="ecole-note">{commune && <>{LC.noteProches} </>}{LP.note} <a href="/methode/#ecoles-proches">{LR.methode}</a>.</p>
      </>
    )}
  </div>
</section>
