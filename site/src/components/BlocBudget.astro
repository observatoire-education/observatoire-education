---
// Bloc « Moyens de la collectivité » : dépenses par élève de la collectivité qui finance les collèges (département)
// ou les lycées (région), au dernier exercice publié. Le privé n'est mis en regard du public que pour le
// fonctionnement, personnel compris ; sans ce poste, la contribution au privé reste seule, sans écart.
import type { NiveauBudget } from "@obs/shared/collectivites";
import type { BudgetCollectivite, MoyennesBudgetFrance } from "@obs/shared/donnees";
import { nombre } from "@obs/shared/format";
import { LIBELLES_BUDGET as L } from "@obs/shared/libelles";
import { absenceBudget, comparaisonBudget, ecartSigne, millions, montantBudget } from "../lib/budget";
import { svgEvolutionBudget } from "../lib/plot";
import Absence from "./Absence.astro";
import Cellule from "./Cellule.astro";

interface Props {
  budget: BudgetCollectivite | null;
  france: MoyennesBudgetFrance | undefined;
  secteurEnPremier: "public" | "prive";
  /** Graphique d'évolution : pages de territoire seulement. */
  evolution: boolean;
  /** Niveau des établissements de la page (une collectivité absente n'en porte pas). */
  niveau: NiveauBudget;
  /** Pourquoi il n'y a pas de collectivité. */
  motif?: "aucune_collectivite" | "collectivite_non_identifiee";
}
const { budget, france, secteurEnPremier, evolution, niveau, motif } = Astro.props;

const e = budget?.exercices.at(-1);
const moy = e ? france?.exercices.find((x) => x.exercice === e.exercice) : undefined;
const contribution = niveau === "colleges" ? L.postes.contributionColleges : L.postes.contributionLycees;

const POSTES = [
  ["horsPersonnel", L.postes.horsPersonnel],
  ["avecPersonnel", L.postes.avecPersonnel],
  ["investissement", L.postes.investissement],
] as const;
const lignesPublic = e
  ? POSTES.map(([cle, libelle]) => ({
    libelle,
    montant: montantBudget(e.public[cle], niveau),
    cmp: comparaisonBudget(e.public[cle], moy?.public[cle]),
  }))
  : [];
const priv = e ? { montant: montantBudget(e.prive.fonctionnement, niveau), cmp: comparaisonBudget(e.prive.fonctionnement, moy?.prive.fonctionnement) } : null;
// Mise en regard : seulement si le personnel compris du public et la contribution au privé sont présents.
const pu = e?.public.avecPersonnel;
const pr = e?.prive.fonctionnement;
const regard = pu && pr && pu.statut === "ok" && pu.parEleve !== null && pr.statut === "ok" && pr.parEleve !== null
  ? { public: nombre(pu.parEleve, 0), ecart: ecartSigne(pr.parEleve, pu.parEleve) }
  : null;

const svg = evolution && budget ? svgEvolutionBudget(budget.exercices) : "";
const absenceCollectivite = absenceBudget(motif ?? "collectivite_non_identifiee", niveau);
const partCites = budget?.partCitesScolaires;
const secteurs = secteurEnPremier === "prive" ? (["prive", "public"] as const) : (["public", "prive"] as const);
---
<div class="moyens" data-collectivite={budget?.id}>
  {!budget ? (
    <div class="card"><div class="lab"><span>{L.titre}</span></div><div style="margin:8px 0"><Absence texte={absenceCollectivite} /></div></div>
  ) : !e ? (
    <div class="card"><div class="lab"><span>{budget.libelle}</span></div><div style="margin:8px 0"><Absence texte={absenceBudget("non_disponible", niveau)} /></div></div>
  ) : (
    <>
      <div class="cols2 budget">
        {secteurs.map((s) => s === "public" ? (
          <div class="card">
            <div class="lab"><span>{budget.libelle} · public</span><span class="yr">exercice {e.exercice}</span></div>
            <div class="table-wrap"><table class="cmp mini-t">
              <thead><tr><th>{L.unites.parEleve}</th><th class="n">Montant</th><th class="n">Écart (moyenne)</th></tr></thead>
              <tbody>
                {lignesPublic.map((l) => (
                  <tr>
                    <td>{l.libelle}</td>
                    <td class="n pub"><Cellule texte={l.montant.texte} absent={l.montant.absent} gras={!l.montant.absent} /></td>
                    <td class="n">{l.cmp && <>{l.cmp.texte}{l.cmp.n !== null && <small class="mute">{L.moyenne.de(l.cmp.n)}</small>}</>}</td>
                  </tr>
                ))}
              </tbody>
            </table></div>
          </div>
        ) : priv && (
          <div class="card">
            <div class="lab"><span>{budget.libelle} · privé sous contrat</span><span class="yr">exercice {e.exercice}</span></div>
            <div class="table-wrap"><table class="cmp mini-t">
              <thead><tr><th>{L.unites.parElevePrive}</th><th class="n">Montant</th><th class="n">Écart (moyenne)</th></tr></thead>
              <tbody>
                <tr>
                  <td>{contribution}</td>
                  <td class="n pri"><Cellule texte={priv.montant.texte} absent={priv.montant.absent} gras={!priv.montant.absent} /></td>
                  <td class="n">{priv.cmp && <>{priv.cmp.texte}{priv.cmp.n !== null && <small class="mute">{L.moyenne.de(priv.cmp.n)}</small>}</>}</td>
                </tr>
                {regard && (
                  <tr class="regard">
                    <td>{L.postes.avecPersonnel} (public)</td>
                    <td class="n pub">{regard.public}</td>
                    <td class="n">Écart avec le public : {regard.ecart}</td>
                  </tr>
                )}
              </tbody>
            </table></div>
          </div>
        ))}
      </div>
      {svg && (
        <div class="card" style="margin-top:14px">
          <div class="lab"><span>Évolution · {L.unites.parEleve}</span><span class="yr">{budget.exercices[0]!.exercice} → {budget.exercices.at(-1)!.exercice}</span></div>
          <Fragment set:html={svg} />
          <div class="legend"><span class="sect pub">public</span><span class="sect pri">privé sous contrat</span></div>
        </div>
      )}
      {budget.mentions.includes("agricole") && <p class="mute mention-budget">{L.mentionAgricole}</p>}
      {budget.mentions.includes("cites_scolaires") && partCites !== undefined && <p class="mute mention-budget">{L.mentionCitesScolaires(nombre(partCites, 1))}</p>}
      {e.citesScolaires !== null && e.citesScolaires > 0 && <p class="mute mention-budget">{L.citesScolairesHorsMontants(millions(e.citesScolaires))}</p>}
      <div class="src">{L.source(e.exercice)} · {L.moyenne.calculee}</div>
    </>
  )}
</div>
