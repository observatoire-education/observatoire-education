---
// Gabarit des pages de territoire (France, région, académie, département, commune), en onglets : Synthèse, Collèges,
// Lycées (une section par famille, car les moyennes n'ont de sens qu'à type égal), Écoles, Transport, Résultats,
// Territoires, Moyens de la commune, Sources. Les blocs affichés dépendent du niveau (tableau 6.1 de la spécification
// de la phase 2) ; chacun garde l'`id` de sa section, pour que les anciennes ancres ouvrent le bon onglet.
import type { DonneesTerritoire, NiveauTerritoire } from "@obs/shared/donnees";
import { date, entier, libelleMillesime, nombre, part } from "@obs/shared/format";
import {
  academie, type CodeIndicateur, FAMILLES_PLURIEL, INDICATEURS, LIBELLES, LIBELLES_BUDGET, LIBELLES_COMMUNE_ECOLES, LIBELLES_ONGLETS as LO,
  LIBELLES_SEGREGATION,
} from "@obs/shared/libelles";
import { cheminTerritoire, communeDeRattachement, LIBELLES_PLM } from "@obs/shared/territoires";
import type { Comparaison, Famille, Niveau, Secteur, SourceId } from "@obs/shared/types";
import Base from "../layouts/Base.astro";
import LienSignalement from "./LienSignalement.astro";
import { anneeScolaire, formater } from "../lib/affichage";
import { communesAvecCsv, communesDisponibles, lireFrance, lireSources } from "../lib/donnees";
import { avecOnglets as plusieursOnglets, onglets } from "../lib/onglets";
import { domaine, svgDistribution, svgPoints } from "../lib/plot";
import { famillesDe, nomFamille, partPrive, pluriel } from "../lib/territoire";
import Absence from "./Absence.astro";
import { absenceBudget, motifAbsenceTerritoire, niveauDe } from "../lib/budget";
import Ariane from "./Ariane.astro";
import BlocBudget from "./BlocBudget.astro";
import BlocEcolesCommune from "./BlocEcolesCommune.astro";
import BlocPremierDegre from "./BlocPremierDegre.astro";
import BlocSegregation from "./BlocSegregation.astro";
import BlocTransport from "./BlocTransport.astro";
import BlocTravauxTerritoire from "./BlocTravauxTerritoire.astro";
import CaseIps from "./CaseIps.astro";
import Cellule from "./Cellule.astro";
import CourbeIpsTerritoire from "./CourbeIpsTerritoire.astro";
import ListeEtablissements from "./ListeEtablissements.astro";
import ListeTerritoires from "./ListeTerritoires.astro";
import Nuage from "./Nuage.astro";
import Onglets from "./Onglets.astro";
import Panneau from "./Panneau.astro";
import SyntheseTerritoire from "./SyntheseTerritoire.astro";
import TableauBudget from "./TableauBudget.astro";

interface Props { d: DonneesTerritoire }
const { d } = Astro.props;
const niveau: NiveauTerritoire = d.ref.niveau;
const chemin = cheminTerritoire(d.ref);
const aca = niveau === "academie" ? d.ref : d.parents.find((p) => p.niveau === "academie");
const dep = d.parents.find((p) => p.niveau === "departement");
const france = lireFrance();
const familles = famillesDe(d);
/** Commune sans page pour le second degré (spec, 6.7) : page de ses écoles seulement, plus légère. */
const seulementEcoles = niveau === "commune" && familles.length === 0;
/** Sources d'une page des écoles seulement : celles de ses blocs (toutes les sources sur les autres pages). */
const SOURCES_ECOLES = new Set<SourceId>(["annuaire", "fermes", "effectifs_ecoles", "ips_ecoles_2016", "ips_ecoles", "cog_communes", "cog_mouvements"]);
/** Page commune : dépenses de la commune pour ses écoles, ou leur absence (commune qui a une école publique ouverte). */
const budgetCommune = niveau === "commune" ? (d.budget.collectivites.find((c) => c.niveau === "ecoles") ?? null) : null;
const avecBudgetCommune = budgetCommune !== null || d.budget.motif !== undefined;
const sources = Object.values(lireSources()).filter((s) => s.actuelle
  && (!seulementEcoles || SOURCES_ECOLES.has(s.id) || (avecBudgetCommune && s.id.startsWith("budget_"))));
const total = familles.reduce((a, [, s]) => a + s.compte.public + s.compte.prive, 0);
const academies = d.academies ?? [];
/** Premier onglet de lycées : le bloc des moyens des régions n'y figure qu'une fois, pas à chaque famille. */
const premierLycee = familles.find(([f]) => f !== "college")?.[0];
const avecBudget = (f: Famille) => niveau !== "commune" && (f === "college" || f === premierLycee);
const avecEtablissements = niveau === "departement" || niveau === "commune";
/** Premier degré (département, académie, région, France) : bloc présent dès qu'il y a une école, ouverte ou fermée. */
const pd = d.premierDegre;
const avecPremierDegre = pd !== undefined
  && (pd.compte.public + pd.compte.prive > 0 || pd.historique.length > 0 || pd.fermetures.length > 0 || pd.horsContrat > 0);

/** Le territoire et ses niveaux supérieurs, du plus proche au plus large (colonnes des moyennes). */
const NIVEAUX: Niveau[] =
  niveau === "departement" ? ["departement", "academie", "france"]
  : niveau === "academie" ? ["academie", "france"]
  : niveau === "region" ? ["france"]
  : niveau === "france" ? ["france"]
  : [];
const nom = niveau === "academie" ? academie(d.ref.libelle) : d.ref.libelle;
const titre = niveau === "departement" ? `${d.ref.libelle} (${d.ref.code})` : niveau === "commune" && dep ? `${d.ref.libelle} (${dep.code})` : nom;
const lieu =
  niveau === "departement" ? `du département ${d.ref.libelle}`
  : niveau === "academie" ? `de l'${nom.charAt(0).toLowerCase()}${nom.slice(1)}`
  : niveau === "region" ? `de la région ${nom}`
  : niveau === "commune" ? `de la commune de ${d.ref.libelle}`
  : "en France";
const csv =
  niveau === "france" ? { href: `${chemin}academies.csv`, texte: "Télécharger les académies (CSV)" }
  : niveau === "academie" || niveau === "region" ? { href: `${chemin}departements.csv`, texte: "Télécharger les départements (CSV)" }
  : niveau === "commune" && dep && !communesAvecCsv().has(d.ref.code)
    ? { href: `${cheminTerritoire(dep)}etablissements.csv`, texte: LIBELLES_COMMUNE_ECOLES.csvDepartement }
  : { href: `${chemin}etablissements.csv`, texte: "Télécharger la liste (CSV)" };
const libelleNiveau = (n: Niveau) => (n === "departement" ? (dep ?? d.ref).libelle : n === "academie" ? academie(aca?.libelle ?? "") : "France");
const enteteNiveau = (n: Niveau) => (n === "departement" ? "Dép." : n === "academie" ? "Académie" : "France");
const titreMoyennes =
  niveau === "departement" ? "Moyennes du département" : niveau === "academie" ? "Moyennes de l'académie" : "Moyennes nationales";
const ref = (c: Comparaison[], n: Niveau, s: Secteur) => {
  const x = c.find((y) => y.niveau === n);
  return x ? (s === "public" ? x.public : x.prive) : undefined;
};
const moyenneTexte = (code: CodeIndicateur, c: Comparaison[], n: Niveau, s: Secteur) => {
  const m = ref(c, n, s);
  if (!m || m.statut !== "ok" || m.valeur === null) {
    return { t: m?.statut === "non_publie_prive" ? LIBELLES.nonPubliePrive : LIBELLES.nonDisponible, abs: true };
  }
  return { t: formater(code, m.valeur), abs: false };
};
const somme = (a: number | null, b: number | null) => (a === null && b === null ? null : (a ?? 0) + (b ?? 0));
// Communes (département) : une puce par commune de la liste (arrondissements rattachés à leur ville),
// reconnue par son code INSEE ; un lien quand la commune a sa page.
const pages = new Map(d.communes.filter((c) => communesDisponibles().has(c.code)).map((c) => [c.code, c]));
const libellePlm = (code: string): string | undefined => LIBELLES_PLM[code as keyof typeof LIBELLES_PLM];
const communes = niveau === "departement"
  ? [...Map.groupBy(familles.flatMap(([, s]) => s.liste), (l) => communeDeRattachement(l.codeCommune))]
    .map(([code, l]) => ({ code, c: pages.get(code)?.libelle ?? libellePlm(code) ?? l[0]!.commune, n: l.length as number | null, page: pages.get(code) }))
  : [];
for (const [code, page] of pages) if (!communes.some((x) => x.code === code)) communes.push({ code, c: page.libelle, n: null, page });
communes.sort((a, b) => a.c.localeCompare(b.c, "fr"));
/** « Les 3 collèges » ; pour un seul : « Le collège » (« L'EREA », élidé). */
const titreListe = (f: Famille, n: number) =>
  n === 1 ? (f === "erea" ? `L'${nomFamille(f, 1)}` : `Le ${nomFamille(f, 1)}`) : `Les ${entier(n)} ${nomFamille(f, n)}`;
/** Onglets (spec, 5.3 et 5.4) : chaque bloc garde l'`id` de sa section ; un onglet sans contenu n'est pas rendu. */
const groupesFamilles = [
  { id: "o-colleges", libelle: LO.colleges, liste: familles.filter(([f]) => f === "college") },
  { id: "o-lycees", libelle: LO.lycees, liste: familles.filter(([f]) => f !== "college") },
];
/** Commune sans second degré : la Synthèse n'a que ses écoles et la dépense de la commune, s'il y en a. */
const avecSynthese = !seulementEcoles || !!d.ecoles || avecBudgetCommune;
const avecEcoles = avecPremierDegre || !!d.ecoles;
const transportRegions = niveau === "france" && (france.transportRegions ?? []).length > 0;
const avecTransport = !!d.transport || transportRegions;
const avecTravaux = (d.travauxLycees ?? []).length > 0;
const avecResultats = (d.nuages ?? []).length > 0;
const avecTerritoires = niveau !== "commune";
const barre = onglets([
  avecSynthese && { id: "o-synthese", libelle: LO.synthese },
  ...groupesFamilles.map((g) => g.liste.length > 0 && { id: g.id, libelle: g.libelle }),
  avecEcoles && { id: "o-ecoles", libelle: LO.ecoles },
  avecTransport && { id: "o-transport", libelle: LO.transport },
  avecTravaux && { id: "o-travaux", libelle: LO.travaux },
  avecResultats && { id: "o-resultats", libelle: LO.resultats },
  avecTerritoires && { id: "o-territoires", libelle: LO.territoires },
  avecBudgetCommune && { id: "o-moyens-commune", libelle: LO.moyensCommune },
  { id: "o-sources", libelle: LO.sources },
]);
const avec = plusieursOnglets(barre);
/** Panneau affiché d'emblée : le premier onglet de la barre (la Synthèse quand elle existe). */
const premier = barre[0]?.id;
const badges = [
  ...(niveau === "departement" || niveau === "commune") && aca ? [academie(aca.libelle)] : [],
  ...(niveau === "commune" && dep ? [dep.libelle] : []),
  ...(seulementEcoles ? [] : [`${entier(total)} établissements`]),
  ...(niveau === "departement" ? [`${communes.filter((c) => c.n !== null).length} communes avec un collège ou un lycée`] : []),
  ...(niveau === "academie" || niveau === "region" ? [pluriel(d.enfants.length, "département")] : []),
  ...(niveau === "region" ? [pluriel(academies.length, "académie")] : []),
  ...(niveau === "france" ? [pluriel(d.enfants.length, "académie")] : []),
];
---
<Base titre={titre} chemin={chemin}
  description={`${seulementEcoles ? "Écoles publiques et privées sous contrat" : "Collèges et lycées publics et privés sous contrat"} ${lieu} : chiffres publics sourcés et datés.`}>
  <Ariane parents={d.parents} />
  <h1>{nom}{niveau === "departement" && <> <span class="mute num" style="font-weight:400">{d.ref.code}</span></>}</h1>
  <div class="badges">{badges.map((b) => <span class="badge">{b}</span>)}</div>
  <div class="actions">
    <button class="btn primary" type="button" id="imprimer">⎙ Imprimer / PDF</button>
    <a class="btn" href={csv.href} download>⬇ {csv.texte}</a>
    <LienSignalement contexte={{ page: chemin, nom, ...(niveau === "france" ? {} : { code: d.ref.code }) }} />
  </div>
  <Onglets onglets={barre} />
  {avecSynthese && (
    <Panneau id="o-synthese" libelle={LO.synthese} actif={premier === "o-synthese"} avecOnglets={avec}>
      <SyntheseTerritoire d={d} familles={familles} niveau={niveau} onglets={avec ? barre.map((o) => o.id) : []} />
    </Panneau>
  )}

  {groupesFamilles.map(({ id, libelle, liste }) => liste.length > 0 && (
  <Panneau id={id} libelle={libelle} actif={premier === id} avecOnglets={avec}>
  {liste.map(([f, s]) => {
    const ips = s.moyennes.find((m) => m.code === "ips");
    const vs = s.moyennes.find((m) => m.code === "eleves_par_etp_vs");
    const vsPub = vs && NIVEAUX[0] ? ref(vs.comparaisons, NIVEAUX[0], "public") : undefined;
    const rangs = ips ? NIVEAUX.map((n) => {
      const p = ref(ips.comparaisons, n, "public"); const q = ref(ips.comparaisons, n, "prive_sous_contrat");
      return { libelle: libelleNiveau(n), public: p?.statut === "ok" ? p.valeur : null, prive: q?.statut === "ok" ? q.valeur : null };
    }) : [];
    const pf = niveau === "france" ? undefined : france.familles[f];
    return (
      <section id={f}>
        <h2>{FAMILLES_PLURIEL[f]}</h2>
        <div class="kpis">
          <div><div class="k">Élèves · {d.rentree}</div><div class="v">{s.eleves.public === null && s.eleves.prive === null ? "—" : entier(somme(s.eleves.public, s.eleves.prive))}</div>
            <div class="c"><span class="p">{s.eleves.public === null ? LIBELLES.nonDisponible : entier(s.eleves.public)}</span> · <span class="q">{s.eleves.prive === null ? LIBELLES.nonDisponible : entier(s.eleves.prive)}</span></div></div>
          <div><div class="k">Part des élèves dans le privé s. c.</div><div class="v">{partPrive(s.eleves, s.compte.prive === 0) === null ? "—" : part(partPrive(s.eleves, s.compte.prive === 0))}</div>
            <div class="c">{pf && partPrive(pf.eleves) !== null && <>France : {part(partPrive(pf.eleves))}</>}</div></div>
          <CaseIps f={f} s={s} d={d} libelle="IPS moyen" />
          {NIVEAUX.length > 0 && (
            <div><div class="k">Élèves par ETP de vie scolaire</div>
              <div class="v">{vsPub?.statut === "ok" ? nombre(vsPub.valeur) : "—"}</div>
              <div class="c">public · <span style="font-family:var(--sans)">privé : {LIBELLES.nonPubliePrive}</span></div></div>
          )}
        </div>

        {niveau !== "commune" && (
          <div class="cols2" style="margin-top:14px">
            <div class="card">
              <div class="lab"><span>Répartition selon l'IPS</span><span class="yr">{anneeScolaire(d.rentree)}</span></div>
              <Fragment set:html={svgDistribution(s.distributionIps.public, s.distributionIps.prive, s.distributionIps.bornes)} />
              <div class="legend"><span class="sect pub">publics (nombre)</span><span class="sect pri">privés sous contrat (nombre)</span></div>
            </div>
            <div class="card">
              <div class="lab"><span>IPS moyen comparé</span><span class="yr">{anneeScolaire(d.rentree)}</span></div>
              {rangs.length ? <Fragment set:html={svgPoints(rangs, null, domaine(rangs.flatMap((r) => [r.public, r.prive])))} /> : <Absence texte={LIBELLES.nonDisponible} />}
              <div class="legend"><span class="sect pub">public</span><span class="sect pri">privé sous contrat</span></div>
              <div class="src">Moyennes publiées par la DEPP (IPS des collèges et des lycées).</div>
            </div>
          </div>
        )}

        {f === "college" && (d.segregation ?? []).length > 0 && <BlocSegregation annees={d.segregation!} />}
        {f === "college" && (niveau === "academie" || niveau === "region" || niveau === "france") && (
          <p class="src" id="segregation-renvoi">{LIBELLES_SEGREGATION.renvoi}</p>
        )}

        <CourbeIpsTerritoire historique={s.ipsHistorique} titre="Évolution de l'IPS moyen" />

        {avecBudget(f) && (() => {
          const nb = niveauDe(f);
          const cols = d.budget.collectivites.filter((c) => c.niveau === nb);
          const franceBudget = d.budget.france.find((m) => m.niveau === nb);
          const tableau = cols.length > 0 && (niveau === "france" || niveau === "academie" || niveau === "region") && (nb === "colleges" || cols.length > 2);
          if (cols.length === 0) {
            // Territoire sans collectivité (Mayotte) : l'absence est dite, pas passée sous silence.
            const motif = motifAbsenceTerritoire(d.ref, d.enfants);
            return motif === null ? null : (
              <div class="moyens-territoire">
                <h3 class="sous-titre">{LIBELLES_BUDGET.titre}</h3>
                <div class="moyens"><div class="card"><Absence texte={absenceBudget(motif, nb)} /></div></div>
              </div>
            );
          }
          return (
            <div class="moyens-territoire">
              <h3 class="sous-titre">{LIBELLES_BUDGET.titre}</h3>
              {niveau === "france" && (
                <p><a class="btn" href={`/france/budget-${nb}.csv`} download>⬇ Télécharger le budget des {nb === "colleges" ? "collèges" : "lycées"} (CSV)</a></p>
              )}
              {tableau
                ? <TableauBudget collectivites={cols} niveau={nb} />
                : cols.map((c) => <BlocBudget budget={c} france={franceBudget} secteurEnPremier="public" evolution={true} niveau={nb} />)}
            </div>
          );
        })()}

        {NIVEAUX.length > 0 && (
          <>
            <h3 class="sous-titre">{titreMoyennes}</h3>
            <div class="card" style="padding:4px 6px"><div class="table-wrap">
              <table class="cmp">
                <thead><tr><th>Indicateur</th>
                  {NIVEAUX.flatMap((n) => [<th class="n">{enteteNiveau(n)} public</th>, <th class="n">{enteteNiveau(n)} privé</th>])}
                </tr></thead>
                <tbody>
                  {s.moyennes.map((m) => (
                    <tr>
                      <td>{INDICATEURS[m.code].libelle}</td>
                      {NIVEAUX.flatMap((n) => (["public", "prive_sous_contrat"] as Secteur[]).map((sec) => {
                        const v = moyenneTexte(m.code, m.comparaisons, n, sec);
                        return <td class={`n ${sec === "public" ? "pub" : "pri"}`}><Cellule texte={v.t} absent={v.abs} /></td>;
                      }))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div></div>
            <div class="src" style="border:0">Moyennes calculées (Σ / Σ) sur les établissements dont la donnée est publiée ; IPS : moyennes publiées par la DEPP. <a href="/methode/#moyennes">Méthode</a>.</div>
          </>
        )}

        {avecEtablissements && (
          <>
            <h3 class="sous-titre">{titreListe(f, s.liste.length)}</h3>
            <ListeEtablissements famille={f} liste={s.liste} />
          </>
        )}
      </section>
    );
  })}
  </Panneau>
  ))}

  {avecEcoles && (
    <Panneau id="o-ecoles" libelle={LO.ecoles} actif={premier === "o-ecoles"} avecOnglets={avec}>
      {avecPremierDegre && <BlocPremierDegre p={pd!} territoire={d.ref} communes={d.communesEcoles} />}
      {d.ecoles && <BlocEcolesCommune e={d.ecoles} commune={d.ref} />}
    </Panneau>
  )}

  {avecTransport && (
    <Panneau id="o-transport" libelle={LO.transport} actif={premier === "o-transport"} avecOnglets={avec}>
      {d.transport && <BlocTransport t={d.transport} region={niveau === "region" ? d.ref.code : undefined} />}
      {transportRegions && <BlocTransport regions={france.transportRegions} />}
    </Panneau>
  )}

  {avecTravaux && (
    <Panneau id="o-travaux" libelle={LO.travaux} actif={premier === "o-travaux"} avecOnglets={avec}>
      <BlocTravauxTerritoire lignes={d.travauxLycees!} />
    </Panneau>
  )}

  {avecResultats && (
    <Panneau id="o-resultats" libelle={LO.resultats} actif={premier === "o-resultats"} avecOnglets={avec}>
      <section id="nuages">
        <h2>Résultats</h2>
        {d.nuages!.map((n) => <Nuage n={n} />)}
      </section>
    </Panneau>
  )}

  {avecTerritoires && <Panneau id="o-territoires" libelle={LO.territoires} actif={premier === "o-territoires"} avecOnglets={avec}>
  {niveau === "france" && (
    <section id="regions">
      <h2>Régions</h2>
      <div class="chips">{[...france.regions].sort((a, b) => a.libelle.localeCompare(b.libelle, "fr")).map((r) => (
        <a class="chip chip-texte" href={cheminTerritoire(r)}>{r.libelle}</a>
      ))}</div>
    </section>
  )}

  {(niveau === "france" || niveau === "academie" || niveau === "region") && (
    <section id="territoires">
      <h2>{niveau === "france" ? "Académies" : niveau === "region" ? "Départements de la région" : "Départements de l'académie"}</h2>
      <ListeTerritoires lignes={d.enfants} />
    </section>
  )}

  {niveau === "region" && academies.length > 0 && (
    <section id="academies">
      <h2>Académies de la région</h2>
      <div class="chips">{academies.map((a) => <a class="chip chip-texte" href={cheminTerritoire(a)}>{academie(a.libelle)}</a>)}</div>
    </section>
  )}

  {niveau === "departement" && (
    <section id="communes">
      <h2>Communes</h2>
      <div class="chips">{communes.map(({ c, n, page }) => {
        const t = n === null ? c : `${c} · ${n}`;
        return page ? <a class="chip chip-texte" href={cheminTerritoire(page)}>{t}</a> : <span class="chip chip-texte">{t}</span>;
      })}</div>
    </section>
  )}
  </Panneau>}

  {avecBudgetCommune && (
    <Panneau id="o-moyens-commune" libelle={LO.moyensCommune} actif={premier === "o-moyens-commune"} avecOnglets={avec}>
    <section id="moyens-commune">
      <h2>{LIBELLES_BUDGET.titreCommune}</h2>
      <BlocBudget budget={budgetCommune} france={d.budget.france.find((m) => m.niveau === "ecoles")} secteurEnPremier="public"
        evolution={true} niveau="ecoles" motif={d.budget.motif} />
    </section>
    </Panneau>
  )}

  <Panneau id="o-sources" libelle={LO.sources} actif={premier === "o-sources"} avecOnglets={avec}>
  <section id="sources">
    <h2>Sources</h2>
    <div class="card" style="font-size:13px"><ul style="margin:0;padding-left:18px;line-height:1.9">
      {sources.map((s) => <li>{s.producteur}, <a href={s.pageUrl}>{s.titre}</a> · collecté le {date(s.actuelle!.collecteLe)} · <a href={s.actuelle!.url}>donnée brute</a></li>)}
      {(d.corrections ?? []).map((c) => (
        <li>{lireSources()[c.source]?.titre} · {LIBELLES.correction(libelleMillesime(c.source, c.millesime), c.le)} : <a href={c.precedente}>{LIBELLES.versionPrecedente}</a> · <a href={c.corrigee}>{LIBELLES.versionCorrigee}</a></li>
      ))}
    </ul></div>
  </section>
  </Panneau>
  <script is:inline src="/js/liste.js" defer></script>
  <script is:inline src="/js/onglets.js" defer></script>
  <script is:inline src="/js/fiche.js" defer></script>
</Base>
