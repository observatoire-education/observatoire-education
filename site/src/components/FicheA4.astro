---
// Fiche imprimable A4 : même page, masquée à l'écran, seule affichée à l'impression (window.print()).
// Tableaux seulement (aucun graphique), moyennes seules, chaque ligne renvoie à sa source numérotée.
// Une école : fiche titrée pour le conseil d'école, avec ses classes, sans vie scolaire, budget ni voisins.
import QRCode from "qrcode";
import Fermeture from "./Fermeture.astro";
import { date, entier, estSession, nombre } from "@obs/shared/format";
import { academie, type CodeIndicateur, CONTRATS, estEcole, FAMILLES, FAMILLES_PLURIEL, INDICATEURS, LIBELLES, LIBELLES_BUDGET, LIBELLES_ECOLES, LIBELLES_RESULTATS as LR, libelleTypeClasse, SECTEURS } from "@obs/shared/libelles";
import type { Fiche, Mesure, Niveau, ResultatsVoie, Secteur, SourceId, ValeurResultat } from "@obs/shared/types";
import { anneeScolaire, formater, indicateur, mentionMoyennesA4, reference } from "../lib/affichage";
import { absenceBudget, montantBudget, niveauDe } from "../lib/budget";
import { CONFIG, lienPermanent } from "../lib/config";
import { tauxEntier, vaSignee } from "../lib/resultats";

interface Props { f: Fiche; genereLe: string }
const { f, genereLe } = Astro.props;
const lien = lienPermanent(`/etablissement/${f.uai}/`);
const qr = await QRCode.toString(lien, { type: "svg", margin: 0, errorCorrectionLevel: "M" });
const prive = f.secteur === "prive_sous_contrat";
const ecole = estEcole(f.famille);
const ipsCalculee = indicateur(f, "ips").comparaisons.some((c) => c.calculee);

// Numéro de chaque source dans le pied de page. La fiche A4 d'un collège ne reprend pas la liste des écoles de son
// secteur : les sources de cette liste (élèves et IPS des écoles) n'y figurent pas.
const LISTE_ECOLES = new Set<SourceId>(["effectifs_ecoles", "ips_ecoles", "ips_ecoles_2016"]);
const sources = ecole ? f.sources : f.sources.filter((s) => !LISTE_ECOLES.has(s.id));
const numero = new Map<SourceId, number>(sources.map((s, i) => [s.id, i + 1]));
const renvoi = (id: SourceId | null | undefined) => (id && numero.has(id) ? `[${numero.get(id)}]` : "");

/** Moyenne seule (sans écart) ; absences abrégées, définies en pied de page. */
const moyenne = (code: CodeIndicateur, m: Mesure | undefined) =>
  !m || m.statut === "non_disponible" || m.valeur === null
    ? { t: m?.statut === "non_publie_prive" ? "non publié" : "n. d.", abs: true }
    : { t: formater(code, m.valeur), abs: false };
const etab = (code: CodeIndicateur, m: Mesure) =>
  m.statut === "non_publie_prive" ? { t: "non publié", abs: true }
  : m.statut !== "ok" || m.valeur === null ? { t: "n. d.", abs: true }
  : { t: formater(code, m.valeur), abs: false };

const LIGNES: [CodeIndicateur, string][] = [
  ["part_filles", "Part de filles"],
  ["ips", "IPS"],
  ["eleves_par_etp_ens", "Élèves par ETP enseignant"],
  ["eleves_par_etp_vs", "Élèves par ETP de vie scolaire"],
  ["part_enseignantes", "Enseignantes (part des ETP)"],
  ["part_non_titulaires", "Enseignants non titulaires"],
  ["part_agreges", "Agrégés"],
  ["part_moins_35", "Enseignants de moins de 35 ans"],
  ["part_50_plus", "Enseignants de 50 ans ou plus"],
  ["part_anciennete_moins_2", "Présents depuis moins de 2 ans"],
  ["part_anciennete_8_plus", "Présents depuis 8 ans ou plus"],
];
const LIGNES_ECOLE: [CodeIndicateur, string][] = [
  ["eleves_par_classe", LIBELLES_ECOLES.elevesParClasse],
  ["ips", "IPS"],
  ["eleves_par_etp_ens", "Élèves par ETP enseignant"],
  ["part_enseignantes", "Enseignantes (part des ETP)"],
  ["part_moins_35", "Enseignants de moins de 35 ans"],
  ["part_50_plus", "Enseignants de 50 ans ou plus"],
  ["part_anciennete_moins_2", "Présents depuis moins de 2 ans"],
  ["part_anciennete_8_plus", "Présents depuis 8 ans ou plus"],
];
const COLONNES: [Niveau, Secteur][] = [
  ["departement", "public"], ["departement", "prive_sous_contrat"],
  ["academie", "public"], ["academie", "prive_sous_contrat"],
  ["france", "public"], ["france", "prive_sous_contrat"],
];
const present = (code: CodeIndicateur) => f.indicateurs.some((i) => i.code === code);
const lignes = (ecole ? LIGNES_ECOLE.filter(([code]) => present(code)) : LIGNES).map(([code, libelle]) => {
  const i = indicateur(f, code);
  const src = i.mesure.source ?? i.comparaisons.find((c) => c.public.source)?.public.source ?? null;
  return { code, libelle, i, renvoi: renvoi(src) };
});
const iEleves = indicateur(f, "eleves");
const ecartType = ecole ? null : indicateur(f, "ecart_type_ips");
const rentree = iEleves.mesure.rentree ?? indicateur(f, "ips").mesure.rentree;

const el = f.eleves;
const niveaux = (el?.niveaux ?? []).filter((n) => n.eleves !== 0 && n.eleves !== null);
const renvoiEleves = renvoi(el?.source[0]);
const etp = (code: CodeIndicateur) => etab(code, indicateur(f, code).mesure);
const renvoiPersonnels = renvoi(ecole ? "personnels_ecoles" : "personnels");
const contrat = f.contrat ? (CONTRATS[f.contrat] ?? f.contrat) : null;

// Écoles : classes de la dernière rentrée et leur type ; ULIS et UEEA quand l'école en accueille.
const cl = f.classes ?? null;
const renvoiClasses = renvoi(cl?.source[0]);
const renvoiTypes = renvoi("classes_ecoles");
const lignesSpeciales = ecole ? [
  ...(f.ulis || (el?.ulis ?? 0) > 0 ? [{ libelle: LIBELLES_ECOLES.ulis, eleves: el?.ulis ?? null }] : []),
  ...((el?.ueea ?? 0) > 0 ? [{ libelle: LIBELLES_ECOLES.ueea, eleves: el?.ueea ?? null }] : []),
] : [];

// Moyens de la collectivité : trois lignes (hors personnel, personnel compris, contribution au privé), moyennes France seules.
// Aucun pour une école (lot 4) : `niveauDe` ne prend qu'une famille du second degré.
const niveauBudget = ecole ? null : niveauDe(f.famille);
const budget = ecole ? null : (niveauBudget === "colleges" ? f.budget.colleges : f.budget.lycees) ?? null;
const exBudget = budget?.exercices.at(-1);
const moyBudget = exBudget ? f.budget.france.find((m) => m.niveau === niveauBudget)?.exercices.find((x) => x.exercice === exBudget.exercice) : undefined;
const renvoiBudget = renvoi(exBudget?.source);
const contribution = niveauBudget === "colleges" ? LIBELLES_BUDGET.postes.contributionColleges : LIBELLES_BUDGET.postes.contributionLycees;
const lignesBudget = exBudget ? [
  { libelle: LIBELLES_BUDGET.postes.horsPersonnel, m: exBudget.public.horsPersonnel, moy: moyBudget?.public.horsPersonnel, secteur: "public" as const, unite: LIBELLES_BUDGET.unites.parEleve },
  { libelle: LIBELLES_BUDGET.postes.avecPersonnel, m: exBudget.public.avecPersonnel, moy: moyBudget?.public.avecPersonnel, secteur: "public" as const, unite: LIBELLES_BUDGET.unites.parEleve },
  { libelle: contribution, m: exBudget.prive.fonctionnement, moy: moyBudget?.prive.fonctionnement, secteur: "prive" as const, unite: LIBELLES_BUDGET.unites.parElevePrive },
].map((l) => ({ ...l, aff: montantBudget(l.m, niveauBudget) })) : [];
const moyenneBudget = (v: { valeur: number | null } | undefined) => (v && v.valeur !== null ? entier(v.valeur) : "n. d.");
// Résultats : dernière session de chaque voie, moyennes seules (pas d'écart).
const libelleRes = (v: ValeurResultat, r: ResultatsVoie) =>
  v.code === "taux_acces" ? (r.voie.startsWith("brevet") ? LR.lignes.tauxAccesBrevet : LR.lignes.tauxAccesBac) : LR.lignes[v.code];
const valRes = (v: ValeurResultat) => (v.statut !== "ok" || v.valeur === null ? { t: "n. d.", abs: true } : { t: v.code === "note_ecrit" ? nombre(v.valeur, 1) : tauxEntier(v.valeur), abs: false });
const vaRes = (v: ValeurResultat) => (v.statutVa === "ok" && v.va !== null ? vaSignee(v.va) : v.statutVa === "sans_objet" ? "" : "n. d.");
const moyRes = (v: ValeurResultat, n: Niveau, s: Secteur) => {
  const c = v.comparaisons.find((x) => x.niveau === n);
  const m = c ? (s === "public" ? c.public : c.prive) : undefined;
  return m === undefined || m === null ? (v.comparaisons.length ? "n. d." : "") : nombre(m, 1);
};
const nd = (v: number | null) => (v === null ? "n. d." : entier(v));
---
<div class="a4" aria-hidden="true">
  <div class="hd">
    <div>
      {ecole && <div class="m"><b>{LIBELLES_ECOLES.ficheA4}</b></div>}
      <div class="t">{f.nom}</div>
      <div class="m">
        <b>{SECTEURS[f.secteur]}</b>{contrat && ` · ${contrat}`} · {FAMILLES[f.famille]}{f.ep && ` · ${f.ep}`}{f.segpa && " · SEGPA"}{f.ulis && " · ULIS"} · UAI <span class="num">{f.uai}</span>
      </div>
      <div class="m">{f.adresse}, {f.codePostal} {f.commune} · {f.depLibelle} ({f.dep}) · {academie(f.acaLibelle)}</div>
      {f.fermeLe === null && f.disparuLe && <div class="m"><b>{LIBELLES.disparu(f.disparuLe)}</b></div>}
      <Fermeture f={f} gras />
    </div>
    <div class="qrw">
      <div>Fiche éditée le {date(genereLe)}<br /><span class="num">{lien}</span></div>
      <div class="qr" set:html={qr} />
    </div>
  </div>

  <div class="centre">
    <h3>Indicateurs, comparés aux moyennes des {FAMILLES_PLURIEL[f.famille].toLowerCase()} · rentrée {anneeScolaire(rentree)}</h3>
    <table>
      <thead>
        <tr class="grp"><th></th><th></th><th colspan="2">{f.depLibelle}</th><th colspan="2">{academie(f.acaLibelle)}</th><th colspan="2">France</th></tr>
        <tr>
          <th>Indicateur</th><th>{ecole ? "École" : "Établissement"}</th>
          {COLONNES.map(([, s]) => <th><span class={`sym ${s === "public" ? "pub" : "pri"}`}></span>{s === "public" ? "public" : "privé s. c."}</th>)}
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Élèves <sup>{renvoiEleves}</sup></td>
          <td class="n me">{iEleves.mesure.valeur !== null ? entier(iEleves.mesure.valeur) : "n. d."}</td>
          <td class="hist" colspan="6">{iEleves.historique.slice(0, -1).slice(-4).map(([a, v]) => `${a} : ${entier(v)}`).join(" · ")}</td>
        </tr>
        {ecole && (
          <tr>
            <td>{LIBELLES_ECOLES.classes} {renvoiClasses && <sup>{renvoiClasses}</sup>}</td>
            <td class={`n me${cl?.total ? "" : " np"}`}>{cl?.total ? entier(cl.total) : "n. d."}</td>
            <td class="hist" colspan="6">{(cl?.historique ?? []).slice(0, -1).slice(-4).map(([a, , c]) => `${a} : ${c ? entier(c) : "n. d."}`).join(" · ")}</td>
          </tr>
        )}
        {lignes.map(({ code, libelle, i, renvoi }) => {
          const e = etab(code, i.mesure);
          return (
            <tr>
              <td>{libelle} {renvoi && <sup>{renvoi}</sup>}</td>
              <td class={`n me${e.abs ? " np" : ""}`}>{e.t}</td>
              {COLONNES.map(([n, s]) => {
                const m = moyenne(code, reference(i, n, s));
                return <td class={`n${m.abs ? " np" : ""}`}>{m.t}</td>;
              })}
            </tr>
          );
        })}
        {ecartType && (
          <tr>
            <td>Écart-type de l'IPS {renvoi(ecartType.mesure.source) && <sup>{renvoi(ecartType.mesure.source)}</sup>}</td>
            <td class="n me">{ecartType.mesure.valeur !== null ? nombre(ecartType.mesure.valeur) : "n. d."}</td>
            <td colspan="6"></td>
          </tr>
        )}
        {lignesBudget.map((l) => (
          <tr>
            <td>{l.libelle} ({l.unite}) <sup>{renvoiBudget}</sup></td>
            <td class={`n me${l.aff.absent ? " np" : ""}`}>{l.aff.absent ? "n. d." : l.aff.texte}</td>
            <td class="hist" colspan="4">{l.aff.absent ? l.aff.texte : `${budget!.libelle} · exercice ${exBudget!.exercice}`}</td>
            {l.secteur === "public"
              ? <><td class={`n${moyenneBudget(l.moy) === "n. d." ? " np" : ""}`}>{moyenneBudget(l.moy)}</td><td></td></>
              : <><td></td><td class="n">{moyenneBudget(l.moy)}</td></>}
          </tr>
        ))}
        {!ecole && !budget && (
          <tr>
            <td>{LIBELLES_BUDGET.titre}</td>
            <td class="n me np">n. d.</td>
            <td class="hist" colspan="6">{absenceBudget(f.budget.motif ?? "collectivite_non_identifiee", niveauBudget)}</td>
          </tr>
        )}
      </tbody>
    </table>
  </div>

  {f.resultats.length > 0 && (
    <div class="centre">
      <h3>{LR.titre}, comparés aux moyennes calculées par l'observatoire</h3>
      {f.resultats.map((r) => (
        <table>
          <thead>
            <tr class="grp"><th>{LR.voies[r.voie]} · {LR.session(r.session)} <sup>{renvoi(r.source)}</sup></th><th></th><th></th><th colspan="2">{f.depLibelle}</th><th colspan="2">{academie(f.acaLibelle)}</th><th colspan="2">France</th></tr>
            <tr><th>{LR.effectif[r.voie]} : {r.effectif === null ? "n. d." : entier(r.effectif)}</th><th>Établissement</th><th>{LR.colonneVa}</th>{COLONNES.map(([, s]) => <th><span class={`sym ${s === "public" ? "pub" : "pri"}`}></span>{s === "public" ? "public" : "privé s. c."}</th>)}</tr>
          </thead>
          <tbody>
            {r.valeurs.map((v) => {
              const e = valRes(v);
              return (
                <tr>
                  <td>{libelleRes(v, r)}</td>
                  <td class={`n me${e.abs ? " np" : ""}`}>{e.t}</td>
                  <td class="n">{vaRes(v)}</td>
                  {COLONNES.map(([n, s]) => <td class="n">{moyRes(v, n, s)}</td>)}
                </tr>
              );
            })}
            {r.mentions && <tr><td>{LR.lignes.mentions}</td><td class="n me" colspan="2">{[r.mentions.ab, r.mentions.b, r.mentions.tb].map(nd).join(" · ")}</td><td colspan="6"></td></tr>}
            {r.voie === "brevet_pro" && <tr><td colspan="9" class="hist">{LR.vaNonPublieePro}</td></tr>}
          </tbody>
        </table>
      ))}
    </div>
  )}

  {ecole && (
    <div class="two">
      <div>
        <h3>Élèves par niveau {renvoiEleves && <sup>{renvoiEleves}</sup>}</h3>
        <table>
          <thead><tr><th>Niveau</th><th>Élèves</th></tr></thead>
          <tbody>
            {[...niveaux, ...lignesSpeciales].map((n) => <tr><td>{n.libelle}</td><td class="n">{nd(n.eleves)}</td></tr>)}
            <tr><td><b>Total</b></td><td class="n"><b>{nd(el?.total ?? null)}</b></td></tr>
          </tbody>
        </table>
      </div>
      <div>
        <h3>Type des classes {renvoiTypes && <sup>{renvoiTypes}</sup>}</h3>
        <table>
          <tbody>
            {cl?.types?.length ? ([[LIBELLES_ECOLES.unNiveau, 1], [LIBELLES_ECOLES.plusieursNiveaux, 2]] as const).map(([titre, k]) => {
              const ts = cl.types!.filter((t) => (k === 1 ? t.niveaux === 1 : t.niveaux > 1));
              return ts.length > 0 && (
                <>
                  <tr><td><b>{titre}</b></td><td class="n"><b>{entier(ts.reduce((a, t) => a + t.classes, 0))}</b></td></tr>
                  {ts.map((t) => <tr><td>{libelleTypeClasse(t.libelle)}</td><td class="n">{entier(t.classes)}</td></tr>)}
                </>
              );
            }) : <tr><td>Typologie des classes</td><td class="n np">n. d.</td></tr>}
          </tbody>
        </table>
        {present("etp_enseignants") && (
          <>
            <h3>Personnels {renvoiPersonnels && <sup>{renvoiPersonnels}</sup>}</h3>
            <table>
              <tbody>
                <tr><td>ETP enseignants</td><td class={`n${etp("etp_enseignants").abs ? " np" : ""}`}>{etp("etp_enseignants").t}</td></tr>
              </tbody>
            </table>
          </>
        )}
      </div>
    </div>
  )}

  {!ecole && <div class="two">
    <div>
      <h3>Élèves par niveau {renvoiEleves && <sup>{renvoiEleves}</sup>}</h3>
      <table>
        <thead><tr><th>Niveau</th><th>Élèves</th><th>Filles</th><th>Garçons</th></tr></thead>
        <tbody>
          {niveaux.map((n) => <tr><td>{n.libelle}</td><td class="n">{nd(n.eleves)}</td><td class="n">{nd(n.filles)}</td><td class="n">{nd(n.garcons)}</td></tr>)}
          <tr><td><b>Total</b></td><td class="n"><b>{nd(el?.total ?? null)}</b></td><td colspan="2"></td></tr>
          {(f.famille === "college" || f.famille === "erea") && (
            <tr><td>dont SEGPA / ULIS</td><td class="n" colspan="3">{f.segpa ? nd(el?.segpa ?? null) : LIBELLES.pasDeSegpa} / {nd(el?.ulis ?? null)}</td></tr>
          )}
        </tbody>
      </table>
    </div>
    <div>
      <h3>Personnels {renvoiPersonnels && <sup>{renvoiPersonnels}</sup>}</h3>
      <table>
        <tbody>
          <tr><td>ETP total</td><td class={`n${etp("etp_total").abs ? " np" : ""}`}>{etp("etp_total").t}</td></tr>
          <tr><td>ETP enseignants</td><td class={`n${etp("etp_enseignants").abs ? " np" : ""}`}>{etp("etp_enseignants").t}</td></tr>
          <tr><td>ETP de vie scolaire</td><td class={`n${etp("etp_vs").abs ? " np" : ""}`}>{etp("etp_vs").t}</td></tr>
        </tbody>
      </table>
    </div>
  </div>}

  {f.voisins && f.voisins.length > 0 && (
    <div>
      <h3>Établissements voisins ({f.voisins.length} plus proches à moins de 30 km, par distance)</h3>
      <table>
        <thead><tr><th>Établissement</th><th>Secteur</th><th>Commune</th><th>UAI</th><th>Distance</th><th>Élèves</th><th>Élèves / ETP ens.</th><th>IPS</th></tr></thead>
        <tbody>
          {f.voisins.map((v) => (
            <tr>
              <td>{v.nom}</td>
              <td class="g"><span class={`sym ${v.secteur === "public" ? "pub" : "pri"}`}></span>{v.secteur === "public" ? "public" : "privé s. c."}</td>
              <td class="g">{v.commune}</td>
              <td class="n">{v.uai}</td>
              <td class="n">{nombre(v.distanceKm)} km</td>
              <td class="n">{etab("eleves", v.eleves).t}</td>
              <td class="n">{etab("eleves_par_etp_ens", v.elevesParEtpEns).t}</td>
              <td class="n">{etab("ips", v.ips).t}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  <div class="ft">
    <div><b>Sources</b> (Licence Ouverte 2.0 ; versions archivées et téléchargeables sur la page « Sources ») :</div>
    <ol>
      {sources.map((s) => (
        <li>{s.producteur}, {s.titre}{s.rentree !== null && (estSession(s.id) ? ` · session ${s.rentree}` : ` · rentrée ${anneeScolaire(s.rentree)}`)} · collecté le {date(s.collecteLe)}{mentionMoyennesA4(s.id, ipsCalculee)}.</li>
      ))}
    </ol>
    <div>
      {!ecole && <>« non publié » : {LIBELLES.nonPubliePrive} (la DEPP ne publie pas les ETP de vie scolaire des établissements privés sous contrat).{" "}</>}
      « n. d. » : {LIBELLES.nonDisponible}. {LIBELLES.aucunCommentaire}{" "}
      Méthode : {CONFIG.SITE_URL}/methode/
    </div>
  </div>
</div>
