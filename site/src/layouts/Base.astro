---
// Gabarit commun : en-tête, pied de page, thème, référencement contrôlé par INDEXABLE.
import { LIBELLES } from "@obs/shared/libelles";
import { CONFIG, NOM_SITE } from "../lib/config";
import "../styles/obs.css";

interface Props {
  /** Titre de la page, suivi du nom du site ; absent sur l'accueil, dont le title est le nom du site seul. */
  titre?: string;
  description?: string;
  /** Chemin de la page (« /etablissement/0440001A/ ») pour la balise canonical. */
  chemin: string;
}
const { titre, description, chemin } = Astro.props;
const canonical = CONFIG.SITE_URL ? `${CONFIG.SITE_URL}${chemin}` : null;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{titre ? `${titre} — ${NOM_SITE}` : NOM_SITE}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {!CONFIG.INDEXABLE && <meta name="robots" content="noindex" />}
    <script is:inline src="/js/theme.js"></script>
    {CONFIG.UMAMI && <script is:inline defer src={CONFIG.UMAMI.SCRIPT} data-website-id={CONFIG.UMAMI.ID}></script>}
  </head>
  <body>
    <header class="top">
      <div class="container">
        <a class="brand" href="/" aria-label={NOM_SITE}><img src="/favicon.svg" alt="" width="22" height="22" /><span>{NOM_SITE}</span></a>
        <form class="search" action="/" method="get" role="search">
          <label class="visuel-masque" for="q-entete">Rechercher un établissement</label>
          <input id="q-entete" class="search" name="q" placeholder="Nom, commune ou UAI" autocomplete="off" />
        </form>
        <nav aria-label="Navigation principale"><a href="/sources/">Sources</a><a href="/methode/">Méthode</a></nav>
        <button class="theme" type="button" title="Thème clair ou sombre" aria-label="Basculer le thème clair ou sombre">◐</button>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer>
      <div class="container">{NOM_SITE} · {LIBELLES.piedDePage}<br /><a href="/a-propos/">À propos</a> · <a href="/mentions-legales/">Mentions légales</a> · <a class="depot" href={`https://github.com/${CONFIG.DEPOT}`}><svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>Code source</a></div>
    </footer>
  </body>
</html>
