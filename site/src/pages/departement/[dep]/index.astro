---
// Page département : le gabarit de territoire, avec la carte des établissements et les communes.
import Territoire from "../../../components/Territoire.astro";
import { departementsDisponibles, lireTerritoire } from "../../../lib/donnees";

export function getStaticPaths() {
  return departementsDisponibles().map((dep) => ({ params: { dep } }));
}

const d = lireTerritoire({ niveau: "departement", code: Astro.params.dep! });
---
<Territoire d={d} />
