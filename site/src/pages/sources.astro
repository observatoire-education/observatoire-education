---
// Sources : « D'où viennent les chiffres » (bandeau de la fabrique, fiche vitrine démontée), puis chaque jeu, son producteur,
// sa page d'origine et toutes ses versions archivées (liens permanents).
import { date, entier } from "@obs/shared/format";
import { LIBELLES_ABSENCES as LA, LIBELLES_BUDGET } from "@obs/shared/libelles";
import BandeauFabrique from "../components/BandeauFabrique.astro";
import FicheVitrine from "../components/FicheVitrine.astro";
import Base from "../layouts/Base.astro";
import { CONFIG } from "../lib/config";
import { lireFrance, lireSources } from "../lib/donnees";
import { compterFabrique } from "../lib/fabrique";
import { executionsRecentes } from "../lib/journal";
import { chargerVitrine } from "../lib/vitrine";

const sources = Object.values(lireSources());
const executions = executionsRecentes();
const france = lireFrance();
const sansCarte = france.departementsSansCarte ?? [];
const fabrique = compterFabrique(lireSources());
const vitrine = chargerVitrine(CONFIG.VITRINE?.UAI);
/** Requête de la version actuelle (ou la dernière) d'un exercice du budget. */
const requeteArchivee = (s: (typeof sources)[number]): string | undefined =>
  s.id.startsWith("budget_") || s.id.startsWith("transport_") ? (s.actuelle ?? s.versions[s.versions.length - 1])?.requete : undefined;
const ACTIONS: Record<string, string> = { inchange: "inchangé", telecharge: "nouvelle version", rejete: "version rejetée", erreur: "erreur" };
---
<Base titre="Sources" chemin="/sources/" description="Sources des données de l'observatoire : producteurs, jeux, versions archivées et dates de collecte.">
  <div class="texte">
    <h1>D'où viennent les chiffres</h1>
    <p class="mute">Les chiffres de l'observatoire viennent tous de données publiques ouvertes. Le ministère de l'Éducation nationale et sa direction statistique (DEPP) les publient sur data.education.gouv.fr ; la direction générale des Finances publiques (DGFiP), pour le budget des collectivités, sur data.economie.gouv.fr ; les régions Île-de-France et Bretagne, pour les bâtiments et les travaux de leurs lycées, sur data.iledefrance.fr et geobretagne.fr ; l'Insee et l'IGN, pour les communes et leurs contours, sur leurs propres portails. La licence de chaque jeu est indiquée par son producteur. Chaque jeu est publié à part, par thème et souvent par année. L'observatoire les collecte automatiquement chaque nuit (un jeu n'est téléchargé que s'il a changé), archive chaque version telle quelle avec son empreinte, à une adresse permanente, puis les recoupe établissement par établissement : un chiffre cité peut toujours être retrouvé.</p>
    <p class="mute">Les données retraitées par l'observatoire sont diffusées sous Licence Ouverte 2.0.</p>
  </div>
  <BandeauFabrique fabrique={fabrique} depuis={france.seriesDepuis ?? null} lien={false} />
  {vitrine && <FicheVitrine vitrine={vitrine} variante="complete" />}
  {sources.map((s) => (
    <section id={s.id}>
      <h2>{s.titre}</h2>
      <p style="margin:0 0 10px;font-size:14px">{s.producteur} · <a href={s.pageUrl}>page du jeu sur {new URL(s.pageUrl).hostname}</a></p>
      {requeteArchivee(s) && <p class="requete mute" style="margin:0 0 10px;font-size:13px;word-break:break-all">{LIBELLES_BUDGET.interface.requeteRejouee} : <a href={requeteArchivee(s)}><code>{requeteArchivee(s)}</code></a> (extrait filtré sur les collectivités et les fonctions retenues, exercice {s.id.replace(/^(budget|transport)_/, "")}).</p>}
      {s.versions.length === 0 ? <p class="mute">Aucune version archivée.</p> : (
        <div class="card" style="padding:4px 6px"><div class="table-wrap"><table>
          <thead><tr><th>Collectée le</th><th>{s.dateSituation ? "Situation au" : "Modifiée par le producteur"}</th><th class="n">Lignes</th><th>Empreinte</th><th>Archive</th></tr></thead>
          <tbody>
            {[...s.versions].reverse().map((v) => (
              <tr>
                <td class="num">{date(v.collecteLe)}{s.actuelle?.sha256 === v.sha256 && <span class="badge" style="margin-left:8px">utilisée par le site</span>}</td>
                <td class="num">{date(v.modified)}</td>
                <td class="n">{entier(v.lignes)}</td>
                <td class="num" title={v.sha256}>{v.sha256.slice(0, 12)}</td>
                <td><a href={v.url}>donnée brute (Parquet)</a></td>
              </tr>
            ))}
          </tbody>
        </table></div></div>
      )}
    </section>
  ))}
  <section id="absences">
    <h2>{LA.titre}</h2>
    <p class="mute">{LA.evaluations}</p>
    {sansCarte.length === 0 ? <p class="mute">{LA.cartesToutes}</p> : (
      <p class="mute">{LA.cartes} {sansCarte.map((d, i) => <>{i > 0 && ", "}<a href={`/departement/${d.code}/`}>{d.libelle} ({d.code})</a></>)}.</p>
    )}
  </section>
  <section id="rased">
    <h2>Réseaux d'aides spécialisées (RASED)</h2>
    <p class="mute">RASED : aucune donnée ouverte. Les réseaux d'aides spécialisées aux élèves en difficulté ne publient aucun jeu de données par école ; l'observatoire n'en affiche donc aucune.</p>
  </section>
  <section id="contours">
    <h2>Contours des territoires</h2>
    <p style="margin:0 0 10px;font-size:14px">IGN · ADMIN EXPRESS COG CARTO, service WFS de la Géoplateforme (<a href="https://data.geopf.fr/wfs/ows">service</a>)</p>
    <p class="mute">Contours des départements et des communes, simplifiés pour les cartes. Édition : dernière édition disponible au 24 novembre 2026 (le service n'indique pas l'année d'édition). Licence Ouverte 2.0.</p>
  </section>
  <section>
    <h2>Collectes récentes</h2>
    {executions.length === 0 ? <p class="mute">Journal de collecte non disponible pour cette génération du site.</p> : (
      <ul class="upd">
        {executions.map((e) => (
          <li><span class="d">{date(e.date)}</span><span>{Object.entries(e.actions).map(([a, n]) => `${n} ${ACTIONS[a] ?? a}`).join(" · ")}
            {e.details.filter((d) => d.motif && d.action !== "inchange").map((d) => <span class="mute" style="display:block;font-size:12px">{d.source} : {d.motif}</span>)}</span></li>
        ))}
      </ul>
    )}
  </section>
</Base>
