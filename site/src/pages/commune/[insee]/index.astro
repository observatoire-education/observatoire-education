---
// Page commune : au moins SEUIL_COMMUNE collèges et lycées (bandeau avec les IPS moyens calculés par l'observatoire,
// carte des établissements et leur liste), ou au moins une école, ouverte ou fermée depuis 2012 (bloc des écoles).
import Territoire from "../../../components/Territoire.astro";
import { communesDisponibles, lireTerritoire } from "../../../lib/donnees";

export function getStaticPaths() {
  return [...communesDisponibles()].map((insee) => ({ params: { insee } }));
}

const d = lireTerritoire({ niveau: "commune", code: Astro.params.insee! });
---
<Territoire d={d} />
