---
// Accueil : accroche sur l'agrégation des données, chiffres nationaux, recherche, bandeau de la fabrique, fiche vitrine
// courte, comparatif « Pourquoi pas directement à la source ? », territoires, mises à jour des sources, principes.
// Ton neutre : le site décrit ce qu'il fait, jamais ce qu'il faut penser des chiffres.
import { date, entier, part } from "@obs/shared/format";
import { academie, LIBELLES } from "@obs/shared/libelles";
import BandeauFabrique from "../components/BandeauFabrique.astro";
import BlocFrance from "../components/BlocFrance.astro";
import FicheVitrine from "../components/FicheVitrine.astro";
import Base from "../layouts/Base.astro";
import { CONFIG } from "../lib/config";
import { lireFrance, lireSources } from "../lib/donnees";
import { compterFabrique } from "../lib/fabrique";
import { chargerVitrine } from "../lib/vitrine";

const france = lireFrance();
const sources = Object.values(lireSources())
  .filter((s) => s.actuelle)
  .sort((a, b) => b.actuelle!.collecteLe.localeCompare(a.actuelle!.collecteLe));
// L'accueil ne montre que les plus récentes ; la liste complète est sur /sources/.
const MAJ_AFFICHEES = 6;
const f = france.familles;
const compte = (cles: (keyof typeof f)[]) => {
  const pub = cles.reduce((a, k) => a + (f[k]?.compte.public ?? 0), 0);
  const pri = cles.reduce((a, k) => a + (f[k]?.compte.prive ?? 0), 0);
  return { pub, pri, total: pub + pri };
};
const eleves = (s: "public" | "prive") => Object.values(f).reduce((a, x) => a + (x?.eleves[s] ?? 0), 0);
const elevesTotal = eleves("public") + eleves("prive");
const colleges = compte(["college"]);
const lycees = compte(["legt", "lpo", "lp"]);
const erea = compte(["erea"]);
const regions = [...france.regions].sort((a, b) => a.libelle.localeCompare(b.libelle, "fr")).map((r) => ({ r: r.code, l: r.libelle }));
const departements = france.academiesEtDepartements.flatMap((a) => a.departements.map((d) => ({ d: d.dep, l: d.libelle, a: academie(a.libelle) })));
const millions = (n: number) => (n >= 1e6 ? `${(n / 1e6).toLocaleString("fr-FR", { maximumFractionDigits: 1 })} M` : entier(n));
// Premier degré : écoles ouvertes publiques et privées sous contrat, élèves de la dernière rentrée des effectifs des écoles.
const pd = france.premierDegre;
const ecoles = pd ? { pub: pd.compte.public, pri: pd.compte.prive, total: pd.compte.public + pd.compte.prive } : null;
const elevesPd = pd && (pd.eleves.public !== null || pd.eleves.prive !== null)
  ? { total: (pd.eleves.public ?? 0) + (pd.eleves.prive ?? 0), prive: pd.eleves.prive }
  : null;
const derniereCollecte = sources[0]?.actuelle?.collecteLe;
const fabrique = compterFabrique(lireSources());
const depuis = france.seriesDepuis ?? null;
const vitrine = chargerVitrine(CONFIG.VITRINE?.UAI);
const portails = `${fabrique.portails} portail${fabrique.portails > 1 ? "s" : ""}`;
---
<Base chemin="/" description={`Toutes les données publiques sur chaque école, collège et lycée de France : ${entier(fabrique.jeux)} jeux de données recoupés, sourcés et datés, sans palmarès.`}>
  <div class="hero" style="padding-bottom:0">
    <h1>Toutes les données publiques sur l'école, <em>rassemblées établissement par établissement.</em></h1>
    <p class="accroche">Effectifs, composition sociale, enseignants, résultats, budget des collectivités, bâtiments des lycées : l'État et les régions publient ces chiffres dans des dizaines de fichiers, sur {portails}, avec des nomenclatures qui changent d'une année à l'autre. L'observatoire les rassemble, les met bout à bout et les situe par rapport aux moyennes du département, de l'académie et de la France. Chaque chiffre garde sa source et son millésime.</p>
  </div>
  <div class="kpis" style="margin-top:8px">
    {ecoles && <div><div class="k">Écoles</div><div class="v">{entier(ecoles.total)}</div><div class="c"><span class="p">{entier(ecoles.pub)} publiques</span> · <span class="q">{entier(ecoles.pri)} privées</span></div></div>}
    <div><div class="k">Collèges</div><div class="v">{entier(colleges.total)}</div><div class="c"><span class="p">{entier(colleges.pub)} publics</span> · <span class="q">{entier(colleges.pri)} privés</span></div></div>
    <div><div class="k">Lycées</div><div class="v">{entier(lycees.total)}</div><div class="c"><span class="p">{entier(lycees.pub)} publics</span> · <span class="q">{entier(lycees.pri)} privés</span></div></div>
    <div><div class="k"><abbr title="Établissements régionaux d'enseignement adapté">EREA</abbr></div><div class="v">{entier(erea.total)}</div><div class="c"><span class="p">{entier(erea.pub)} publics</span> · <span class="q">{entier(erea.pri)} privés</span></div></div>
    {elevesPd && <div><div class="k">Élèves du premier degré · {pd!.rentrees.eleves}</div><div class="v">{millions(elevesPd.total)}</div>
      <div class="c">{elevesPd.prive !== null && elevesPd.total ? `dont ${part((100 * elevesPd.prive) / elevesPd.total)} dans le privé s. c.` : LIBELLES.nonPubliePrive}</div></div>}
    <div><div class="k">Élèves du second degré · {france.rentree}</div><div class="v">{millions(elevesTotal)}</div>
      <div class="c">dont {elevesTotal ? part((100 * eleves("prive")) / elevesTotal) : "—"} dans le privé s. c.</div></div>
  </div>
  <div class="src" style="border:0;margin-top:6px">
    Sources : MEN, Annuaire de l'éducation{derniereCollecte && ` (collecté le ${date(derniereCollecte)})`} ; MEN-DEPP, effectifs {france.rentree}-{(france.rentree ?? 0) + 1}{pd?.rentrees.eleves && ` ; MEN-DEPP, effectifs des écoles ${pd.rentrees.eleves}-${pd.rentrees.eleves + 1}`}.
    Privé hors contrat ({entier(france.horsContrat)} collèges et lycées{pd && ` et ${entier(pd.horsContrat)} écoles`}) : {LIBELLES.nonCouvert}.
  </div>

  <div style="margin-top:22px">
    <div class="bigsearch" role="search">
      <label class="visuel-masque" for="q">Rechercher un établissement, une commune, un département ou une UAI</label>
      <input class="search" id="q" placeholder="Votre école, votre collège, votre commune, votre département…" autocomplete="off" />
      <div class="res" id="res" aria-live="polite"></div>
    </div>
    <div class="hint">Par exemple : <button type="button">Jules Verne Nantes</button> · <button type="button">Saint-Nazaire</button> · <button type="button">Loire-Atlantique</button></div>
  </div>
  <BandeauFabrique fabrique={fabrique} depuis={depuis} lien={true} />

  {vitrine && <FicheVitrine vitrine={vitrine} variante="courte" />}

  <section>
    <h2>Pourquoi pas directement à la source ?</h2>
    <div class="compare">
      <div>
        <h3>Les portails officiels</h3>
        <ul>
          <li class="o">Les données de référence, complètes</li>
          <li class="x">Un fichier par thème et par année</li>
          <li class="x">Des milliers de lignes, des codes à décoder</li>
          <li class="x">Nomenclatures qui changent, séries coupées</li>
          <li class="x">Aucune moyenne pour situer un établissement</li>
        </ul>
      </div>
      <div>
        <h3>Les sites commerciaux</h3>
        <ul>
          <li class="o">Lisibles et rapides</li>
          <li class="x">Quelques indicateurs, souvent les résultats seuls</li>
          <li class="x">Des notes et des tableaux d'honneur</li>
          <li class="x">Source et date rarement indiquées</li>
          <li class="x">Publicité, comptes, cookies</li>
        </ul>
      </div>
      <div class="obs">
        <h3>L'observatoire</h3>
        <ul>
          <li class="o">{entier(fabrique.jeux)} jeux recoupés sur une seule fiche</li>
          {depuis !== null && <li class="o">Séries remises bout à bout depuis {depuis}</li>}
          <li class="o">Chaque chiffre situé : département, académie, France</li>
          <li class="o">Source, millésime et donnée brute archivée</li>
          <li class="o">Aucune note, aucune publicité, mis à jour chaque nuit</li>
        </ul>
      </div>
    </div>
  </section>

  <section>
    <h2>Parcourir par territoire</h2>
    <BlocFrance france={france} />
  </section>

  <div class="cols2">
    <section style="margin-top:8px">
      <h2>Dernières mises à jour des sources</h2>
      <ul class="upd">
        {sources.slice(0, MAJ_AFFICHEES).map((s) => <li><span class="d">{date(s.actuelle!.collecteLe)}</span><span>{s.titre}</span></li>)}
      </ul>
      <div class="src" style="border:0"><a href="/sources/">Les {sources.length} sources et leurs versions archivées</a> · collecte automatique chaque nuit</div>
    </section>
    <section style="margin-top:8px">
      <h2>Principes</h2>
      <div class="principles">
        <div class="card"><b>Sourcé et daté</b>Chaque chiffre renvoie à sa source, son millésime et la donnée brute archivée.</div>
        <div class="card"><b>Sans palmarès</b>On compare à des moyennes ; aucun établissement n'est noté.</div>
        <div class="card"><b>Absences dites</b>« Non publié pour le privé » n'est jamais remplacé par un zéro.</div>
        <div class="card"><b>Imprimable</b>Chaque fiche tient sur une page A4, avec ses sources.</div>
      </div>
    </section>
  </div>
  <script type="application/json" id="regions" set:html={JSON.stringify(regions)} />
  <script type="application/json" id="departements" set:html={JSON.stringify(departements)} />
  <script is:inline src="/js/recherche.js" defer></script>
</Base>
