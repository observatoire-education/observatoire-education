---
// Fiche établissement : en-tête commun, puis le corps de la fiche d'une école (maternelle, élémentaire,
// primaire) ou d'un collège, lycée, EREA. Graphiques rendus en SVG au build.
import { estEcole, FAMILLES } from "@obs/shared/libelles";
import Entete from "../../components/Entete.astro";
import FicheEcole from "../../components/FicheEcole.astro";
import FicheSecondDegre from "../../components/FicheSecondDegre.astro";
import Base from "../../layouts/Base.astro";
import { lireFiche, lireIndex } from "../../lib/donnees";

export function getStaticPaths() {
  return lireIndex().map((e) => ({ params: { uai: e.u } }));
}

const f = lireFiche(Astro.params.uai!);
const prive = f.secteur === "prive_sous_contrat";
const ecole = estEcole(f.famille);
// Une école est publique ou privée sous contrat (accord au féminin).
const secteur = ecole ? (prive ? "privée sous contrat" : "publique") : prive ? "privé sous contrat" : "public";
---
<Base titre={`${f.nom} · ${f.commune}`} chemin={`/etablissement/${f.uai}/`}
  description={`${FAMILLES[f.famille]} ${secteur} à ${f.commune} (UAI ${f.uai}) : chiffres publics sourcés et datés.`}>
  <Entete f={f} />
  {ecole ? <FicheEcole f={f} /> : <FicheSecondDegre f={f} />}
  <script is:inline src="/js/fiche.js" defer></script>
</Base>
