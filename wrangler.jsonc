{
  "name": "observatoire-education",
  "compatibility_date": "2026-11-01",
  // Script invoqué seulement pour /api/* (formulaire de contact) : toutes les autres adresses sont servies
  // directement depuis ./dist, sans invocation du script.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Domaine du site, servi par le Worker (la zone est gérée par Cloudflare). Le www sert les mêmes pages ;
  // la balise canonical de chaque page pointe vers l'apex.
  "routes": [
    { "pattern": "observatoireeducation.fr", "custom_domain": true },
    { "pattern": "www.observatoireeducation.fr", "custom_domain": true }
  ],
  // L'aperçu de recette (*.workers.dev) et les URL d'aperçu par version ne servent plus après la bascule.
  // Envoi des remontées par Cloudflare Email Sending, depuis le sous-domaine envoi. (onboardé le 2026-11-25 ;
  // MX, SPF et DMARC de l'apex restent ceux d'OVH). Secret à poser hors dépôt : TURNSTILE_SECRET.
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "CONTACT_DESTINATION": "contact@observatoireeducation.fr",
    "CONTACT_EXPEDITEUR": "formulaire@envoi.observatoireeducation.fr",
    "SITE_URL": "https://observatoireeducation.fr"
  },
  "workers_dev": false,
  "preview_urls": false
}
