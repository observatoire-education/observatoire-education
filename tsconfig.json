{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": [
      "bun"
    ]
  },
  "include": [
    "shared/src",
    "pipeline/src",
    "tests",
    "scripts",
    "site/src/lib",
    "worker"
  ]
}
